# =============================================================================
# LangGraph Airport AI Agent Swarm - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI Configuration (Required if using GPT models)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# LangSmith Configuration (Optional - for tracing and monitoring)
# -----------------------------------------------------------------------------
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=airport-agent-swarm

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to SQLite database (relative to project root)
SQL_DATABASE_PATH=database/airport_data.db

# -----------------------------------------------------------------------------
# AWS S3 Configuration (Required for CSV/Plot file storage)
# -----------------------------------------------------------------------------
# Get credentials from AWS IAM: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=your_s3_bucket_name_here

# -----------------------------------------------------------------------------
# Ollama Configuration (Configured in docker-compose.yml)
# -----------------------------------------------------------------------------
# The Ollama container is already set up in docker-compose.yml
# To use Ollama:
#   1. docker exec -it ollama bash
#   2. ollama pull <model_name>
#   3. Edit agents/llm_model.py to set LOCAL_MODEL=True
# 
# Note: OLLAMA_BASE_URL is set automatically by docker-compose
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Redis Configuration (Configured in docker-compose.yml)
# -----------------------------------------------------------------------------
# Redis is managed by docker-compose and connects automatically
# REDIS_URL=redis://redis-chat:6379/0
# -----------------------------------------------------------------------------
